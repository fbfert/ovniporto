# OVNIPORTO production .env template (the VPS). Copy to .env, fill in, `chmod 600 .env`.
# Never commit the filled-in file. Generate secrets with: openssl rand -base64 32
# Hosts, queues, cache and SSR are fixed by docker-compose.prod.yml; only what varies lives here.

APP_NAME=OVNIPORTO
APP_ENV=production
# php artisan key:generate --show (in the app container)
APP_KEY=
APP_DEBUG=false
APP_URL=https://ovniporto.tars.art.br
APP_DOMAIN=ovniporto.tars.art.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_LEVEL=warning

# Where the site answers for the reverse proxy (only on the loopback by default).
WEB_BIND=127.0.0.1:8080
# Caddy from this repository (ports 80/443 free): COMPOSE_PROFILES=caddy. Its Let's Encrypt notices and the metric host.
COMPOSE_PROFILES=
ACME_EMAIL=
METRIC_DOMAIN=metrica.ovniporto.tars.art.br

# enforce | report-only | off (report-only on staging first, see DEPLOY.md)
CSP_MODE=enforce
# Failed jobs (3 tries) and Horizon long-wait notices. Empty = every admin.
ALERTS_EMAIL=

DB_DATABASE=ovniporto
DB_USERNAME=ovniporto
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=

SESSION_LIFETIME=120
SESSION_ENCRYPT=true

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=ola@ovniporto.tars.art.br
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

PAYPAL_MODE=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

MELHOR_ENVIO_ENV=production
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_FROM_POSTAL_CODE=
MELHOR_ENVIO_USER_AGENT="OVNIPORTO (ola@ovniporto.tars.art.br)"
SHIPPING_SENDER_NAME=
SHIPPING_SENDER_PHONE=
SHIPPING_SENDER_EMAIL=
SHIPPING_SENDER_DOCUMENT=
SHIPPING_SENDER_STREET=
SHIPPING_SENDER_NUMBER=
SHIPPING_SENDER_DISTRICT=
SHIPPING_SENDER_CITY=Lages
SHIPPING_SENDER_STATE=SC

# Cookieless metric (the umami service). The website id comes from Umami's panel.
UMAMI_SCRIPT_URL=https://metrica.ovniporto.tars.art.br/script.js
UMAMI_WEBSITE_ID=
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=
