APP_NAME=OVNIPORTO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Host port the nginx (web) service is published on by docker-compose.yml.
APP_PORT=8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 from docker-compose.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ovniporto
DB_USERNAME=ovniporto
DB_PASSWORD=secret
# Native setup without Docker: use SQLite instead (database/database.sqlite)
# and comment out the DB_HOST..DB_PASSWORD lines above.
# DB_CONNECTION=sqlite

# docker-compose.yml forces SESSION_DRIVER/QUEUE_CONNECTION/CACHE_STORE=redis
# for the app and worker containers; these values apply to native runs.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@ovniporto.tars.art.br"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Inertia SSR server: the ssr service in Docker; natively http://127.0.0.1:13714
# (start it with `npm run ssr` after `npm run build`).
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714

# Google login (Laravel Socialite): the only way members sign in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# PayPal (card + Pix). Empty client id: local dev shows a "simulate approval" button;
# production refuses payments until it is set. Webhook: POST /webhooks/paypal.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Melhor Envio (quotes and labels). Empty token: simulated quotes on the product page,
# checkout offers only "Retirar em Lages".
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_FROM_POSTAL_CODE=
# Sender printed on the labels (the store's own data).
SHIPPING_SENDER_NAME=
SHIPPING_SENDER_PHONE=
SHIPPING_SENDER_EMAIL=
SHIPPING_SENDER_DOCUMENT=
SHIPPING_SENDER_STREET=
SHIPPING_SENDER_NUMBER=
SHIPPING_SENDER_DISTRICT=
SHIPPING_SENDER_CITY=Lages
SHIPPING_SENDER_STATE=SC

# Cookieless metric (Umami). The script only loads with APP_ENV=production and both values set.
# The umami + umami-db services run with: docker compose --profile analytics up -d
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
