{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && vite build --ssr",
        "build:client": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js && tsc --noEmit && prettier --check \"resources/js/**/*.{ts,tsx}\" \"resources/css/**/*.css\"",
        "format": "prettier --write \"resources/js/**/*.{ts,tsx}\" \"resources/css/**/*.css\"",
        "ssr": "node bootstrap/ssr/ssr.js",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.3",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.1",
        "laravel-vite-plugin": "^3.1",
        "prettier": "^3.9.9",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.3"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@inertiajs/react": "^3.8.0",
        "exifr": "^7.1.3",
        "leaflet": "^1.9.4",
        "lenis": "^1.3.26",
        "motion": "^13.5.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "name": "ovniporto-site"
}
